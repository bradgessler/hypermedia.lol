source "https://rubygems.org"

# Stand-alone Sitepress server and compiler.
gem "sitepress", "~> 5.0.0.beta"

# Server used for the Sitepress preview server.
gem "webrick"

# Templating engines. Under the hood Sitepress uses a slimmed
# down Rails, so rails templating engines should mostly work.
gem "haml-rails"
gem "slim-rails"
gem "markdown-rails", "~> 2.2"

# Server-side syntax highlighting for fenced code blocks; wired up in
# markdown/application_markdown.rb.
gem "redcarpet"
gem "rouge"

# View component libraries.
gem "phlex-rails"
gem "view_component"
