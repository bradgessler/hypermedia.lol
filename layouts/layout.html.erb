<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset='utf-8'>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= page_title %></title>
    <meta name="description" content="<%= page_description %>">
    <link rel="canonical" href="<%= canonical_url %>">

    <meta property="og:type" content="<%= article? ? "article" : "website" %>">
    <meta property="og:site_name" content="<%= SiteHelper::SITE_NAME %>">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:url" content="<%= canonical_url %>">
    <meta property="og:image" content="<%= og_image_url %>">
    <% if article? %>
      <meta property="article:published_time" content="<%= Date.parse(current_page.data.fetch("date")).iso8601 %>">
    <% end %>

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:creator" content="@bradgessler">

    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Rules for machines">

    <!-- Privacy-friendly analytics by Plausible. Disclosed in the footer. -->
    <script async src="https://plausible.io/js/pa-WF9wT4GAo6d9TvY-p3HG2.js"></script>
    <script>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
    <%= stylesheet_link_tag "site" %>
  </head>
  <body<%= treatment == "plain" ? " style=\"--accent: #{accent}\"".html_safe : "" %> class="<%= home? ? "is-home" : "is-page" %> t-<%= treatment %><%= " light-code" if %w[spec default].include?(treatment) %>">
    <% unless home? %>
      <div class="topmark"><%= site_mark %></div>
    <% end %>
        <main class="<%= home? ? "" : "prose" %>">
      <% unless home? %>
        <div class="banner">
          <div class="banner__art"><%= sprite sprite_name, size: 84 %></div>
          <div class="banner__meta">
            <h1 class="article-title"><%= page_title %></h1>
            <% if current_page.data["byline"] || current_page.data["date"] %>
              <p class="byline">
                <% if (name = current_page.data["byline"]) %>
                  <%= current_page.data.fetch("byline_verb", "Prompted by") %>
                  <% if (url = current_page.data["byline_url"]) %>
                    <a href="<%= url %>" rel="author"><%= name %></a>
                  <% else %>
                    <%= name %>
                  <% end %>
                <% end %>
                <% if current_page.data["date"] %>
                  <% if current_page.data["byline"] %><span class="byline__sep">&middot;</span><% end %>
                  <time datetime="<%= Date.parse(current_page.data.fetch("date")).iso8601 %>"><%= date current_page.data.fetch("date") %></time>
                <% end %>
              </p>
            <% end %>
          </div>
        </div>
      <% end %>
      <% content = yield %>
      <%= treatment == "modalz" ? modalize(content) : content %>

      <% if article? %>
        <nav class="onward">
          <% if (prev = previous_article) %>
            <a class="onward__link" href="<%= path_for prev %>" style="--accent: <%= accent prev %>">
              <span class="onward__dir">&larr; Newer</span>
              <span class="onward__title"><%= prev.data.fetch("title") %></span>
            </a>
          <% end %>
          <% if (nxt = next_article) %>
            <a class="onward__link onward__link--next" href="<%= path_for nxt %>" style="--accent: <%= accent nxt %>">
              <span class="onward__dir">Older &rarr;</span>
              <span class="onward__title"><%= nxt.data.fetch("title") %></span>
            </a>
          <% end %>
        </nav>
      <% end %>
    </main>

    <footer class="foot">
      <a class="mark mark--masthead" href="/">hypermedia.lol</a>
      <p class="foot__about">Over-the-top arguments for using what the browser already does. <a href="/why/">Why this exists &rarr;</a></p>
      <dl class="foot__actions">
        <dt>Share</dt>
        <dd>Pass it on. <a class="share" href="mailto:?subject=<%= ERB::Util.url_encode(page_title) %>&amp;body=<%= ERB::Util.url_encode(canonical_url) %>" data-title="<%= page_title %>" data-url="<%= canonical_url %>">Share this page</a></dd>
        <dt>Contribute</dt>
        <dd><a href="https://github.com/bradgessler/hypermedia.lol/blob/main/CONTRIBUTING.md">Send a pull request.</a> One file, no JavaScript, merged at a dictator's whim.</dd>
        <dt>Machines</dt>
        <dd><a href="/llms.txt">llms.txt</a> has the rules. <a href="https://github.com/bradgessler/hypermedia.lol">Source</a> has everything.</dd>
      </dl>
      <p class="foot__meta">Scripts on this site: the six-box input we argue against, a Copy button, a Share button, Plausible analytics. Each annotated in the source.</p>
    </footer>

    <script>
      // Share. The device's share sheet is navigator.share, which is
      // JavaScript or nothing. The link underneath is a mailto, so with
      // scripts off sharing still works; with them on, the link opens the
      // sheet instead.
      document.querySelectorAll("a.share").forEach((a) => {
        if (!navigator.share) return;
        a.addEventListener("click", (event) => {
          event.preventDefault();
          navigator.share({ title: a.dataset.title, url: a.dataset.url }).catch(() => {});
        });
      });
    </script>
  </body>
</html>
