<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset='utf-8'>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= page_title %></title>
    <meta name="description" content="<%= page_description %>">
    <link rel="canonical" href="<%= canonical_url %>">

    <meta property="og:type" content="<%= article? ? "article" : "website" %>">
    <meta property="og:site_name" content="<%= SiteHelper::SITE_NAME %>">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:url" content="<%= canonical_url %>">
    <meta property="og:image" content="<%= og_image_url %>">
    <% if article? %>
      <meta property="article:published_time" content="<%= Date.parse(current_page.data.fetch("date")).iso8601 %>">
    <% end %>

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:creator" content="@bradgessler">

    <link rel="alternate" type="text/plain" href="/llms.txt" title="Rules for machines">
    <%= stylesheet_link_tag "site" %>
  </head>
  <body<%= treatment == "plain" ? " style=\"--accent: #{accent}\"".html_safe : "" %> class="<%= home? ? "is-home" : "is-page" %> t-<%= treatment %><%= " light-code" if %w[spec default].include?(treatment) %>">
    <% unless home? %>
      <div class="topmark"><%= site_mark %></div>
    <% end %>
        <main class="<%= home? ? "" : "prose" %>">
      <% unless home? %>
        <div class="banner">
          <div class="banner__art"><%= sprite sprite_name, size: 84 %></div>
          <div class="banner__meta">
            <h1 class="article-title"><%= page_title %></h1>
            <% if current_page.data["byline"] || current_page.data["date"] %>
              <p class="byline">
                <% if (name = current_page.data["byline"]) %>
                  <%= current_page.data.fetch("byline_verb", "Prompted by") %>
                  <% if (url = current_page.data["byline_url"]) %>
                    <a href="<%= url %>" rel="author"><%= name %></a>
                  <% else %>
                    <%= name %>
                  <% end %>
                <% end %>
                <% if current_page.data["date"] %>
                  <% if current_page.data["byline"] %><span class="byline__sep">&middot;</span><% end %>
                  <time datetime="<%= Date.parse(current_page.data.fetch("date")).iso8601 %>"><%= date current_page.data.fetch("date") %></time>
                <% end %>
              </p>
            <% end %>
          </div>
        </div>
      <% end %>
      <% content = yield %>
      <%= treatment == "modalz" ? modalize(content) : content %>

      <% if article? %>
        <nav class="onward">
          <% if (prev = previous_article) %>
            <a class="onward__link" href="<%= path_for prev %>" style="--accent: <%= accent prev %>">
              <span class="onward__dir">&larr; Newer</span>
              <span class="onward__title"><%= prev.data.fetch("title") %></span>
            </a>
          <% end %>
          <% if (nxt = next_article) %>
            <a class="onward__link onward__link--next" href="<%= path_for nxt %>" style="--accent: <%= accent nxt %>">
              <span class="onward__dir">Older &rarr;</span>
              <span class="onward__title"><%= nxt.data.fetch("title") %></span>
            </a>
          <% end %>
        </nav>
      <% end %>
    </main>

    <footer class="foot">
      <a class="mark mark--masthead" href="/">hypermedia.lol</a>
      <p class="foot__about">
        Short, over-the-top arguments for using what the browser already does
        instead of rebuilding it in JavaScript. Each one shows a thing breaking,
        then the smaller thing that already worked.
        <a href="/why/">More about this &rarr;</a>
      </p>
      <div class="foot__share" aria-label="Share this page">
        <span class="foot__label">Share</span>
        <a href="https://x.com/intent/post?text=<%= ERB::Util.url_encode(page_title) %>&amp;url=<%= ERB::Util.url_encode(canonical_url) %>">X</a>
        <a href="https://bsky.app/intent/compose?text=<%= ERB::Util.url_encode("#{page_title} #{canonical_url}") %>">Bluesky</a>
        <a href="https://news.ycombinator.com/submitlink?u=<%= ERB::Util.url_encode(canonical_url) %>&amp;t=<%= ERB::Util.url_encode(page_title) %>">Hacker News</a>
        <a href="sms:?&amp;body=<%= ERB::Util.url_encode("#{page_title} #{canonical_url}") %>">Messages</a>
        <a href="mailto:?subject=<%= ERB::Util.url_encode(page_title) %>&amp;body=<%= ERB::Util.url_encode(canonical_url) %>">Email</a>
      </div>
      <p class="foot__contribute">
        Got one of these in you? <a href="https://github.com/bradgessler/hypermedia.lol/blob/main/CONTRIBUTING.md">Send a pull request.</a>
        One file, markdown or HTML, no JavaScript. Merged at the whim of a sometimes-benevolent dictator.
      </p>
      <p class="foot__meta">
        <a href="https://github.com/bradgessler/hypermedia.lol">Source</a>
        <a href="/llms.txt">llms.txt</a>
        <span>JavaScript on this site: the six-box input we argue against, running so you can feel it break, and one Copy button.</span>
      </p>
    </footer>
  </body>
</html>
