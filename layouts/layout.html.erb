<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset='utf-8'>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= page_title %></title>
    <meta name="description" content="<%= page_description %>">
    <link rel="canonical" href="<%= canonical_url %>">

    <meta property="og:type" content="<%= article? ? "article" : "website" %>">
    <meta property="og:site_name" content="<%= SiteHelper::SITE_NAME %>">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:url" content="<%= canonical_url %>">
    <meta property="og:image" content="<%= og_image_url %>">
    <% if article? %>
      <meta property="article:published_time" content="<%= Date.parse(current_page.data.fetch("date")).iso8601 %>">
    <% end %>

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:creator" content="@bradgessler">

    <link rel="alternate" type="text/plain" href="/llms.txt" title="Rules for machines">
    <%= stylesheet_link_tag "site" %>
  </head>
  <body<%= treatment == "plain" ? " style=\"--accent: #{accent}\"".html_safe : "" %> class="<%= home? ? "is-home" : "is-page" %> t-<%= treatment %><%= " light-code" if %w[spec default].include?(treatment) %>">
        <main class="<%= home? ? "" : "prose" %>">
      <% unless home? %>
        <div class="banner">
          <div class="banner__art"><%= sprite sprite_name, size: 84 %></div>
          <div class="banner__meta">
            <h1 class="article-title"><%= page_title %></h1>
            <% if current_page.data["byline"] || current_page.data["date"] %>
              <p class="byline">
                <% if (name = current_page.data["byline"]) %>
                  <%= current_page.data.fetch("byline_verb", "Prompted by") %>
                  <% if (url = current_page.data["byline_url"]) %>
                    <a href="<%= url %>" rel="author"><%= name %></a>
                  <% else %>
                    <%= name %>
                  <% end %>
                <% end %>
                <% if current_page.data["date"] %>
                  <% if current_page.data["byline"] %><span class="byline__sep">&middot;</span><% end %>
                  <time datetime="<%= Date.parse(current_page.data.fetch("date")).iso8601 %>"><%= date current_page.data.fetch("date") %></time>
                <% end %>
              </p>
            <% end %>
          </div>
        </div>
      <% end %>
      <% content = yield %>
      <%= treatment == "modalz" ? modalize(content) : content %>

      <% if article? %>
        <nav class="onward">
          <% if (prev = previous_article) %>
            <a class="onward__link" href="<%= path_for prev %>" style="--accent: <%= accent prev %>">
              <span class="onward__dir">&larr; Newer</span>
              <span class="onward__title"><%= prev.data.fetch("title") %></span>
            </a>
          <% end %>
          <% if (nxt = next_article) %>
            <a class="onward__link onward__link--next" href="<%= path_for nxt %>" style="--accent: <%= accent nxt %>">
              <span class="onward__dir">Older &rarr;</span>
              <span class="onward__title"><%= nxt.data.fetch("title") %></span>
            </a>
          <% end %>
        </nav>
      <% end %>
    </main>

    <%= site_mark %>

    <footer>
      <a href="https://github.com/bradgessler/hypermedia.lol">Source &amp; submissions</a>
      <a href="/llms.txt">llms.txt</a>
      <span>JavaScript on this site: the six-box input we argue against, running so you can feel it break, and one Copy button.</span>
    </footer>
  </body>
</html>
